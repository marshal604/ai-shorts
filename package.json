{
  "name": "ai-shorts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把交易分析長影片濃縮成直式短影片：以口令錨點定位，類別驅動的管線",
  "bin": {
    "ai-shorts-render": "./bin/render.mjs"
  },
  "scripts": {
    "transcribe": "tsx src/cli/transcribe.ts",
    "anchors": "tsx src/cli/anchors.ts",
    "render": "tsx src/cli/render.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "opencc-js": "^1.4.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
